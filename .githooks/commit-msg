#!/bin/sh
# Rejects commit messages that do not follow Conventional Commits (rule С6).
# Enable once per clone with: make setup

header=$(grep -v '^#' "$1" | head -n 1)
pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+'

case "$header" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
	echo "commit-msg: header is not a Conventional Commit:" >&2
	echo "  $header" >&2
	echo "expected: type(scope): summary, e.g. 'feat(config): read INI file'" >&2
	echo "types: build chore ci docs feat fix perf refactor revert style test" >&2
	exit 1
fi

if [ "${#header}" -gt 100 ]; then
	echo "commit-msg: header is longer than 100 characters" >&2
	exit 1
fi
